#compdef q-secret-env

_q_secret_env_names() {
  local -a names
  names=(${(f)"$(q-secret-env list 2>/dev/null)"})
  _describe -t env_names 'env name' names "$@"
}

_q_secret_env() {
  local curcontext="$curcontext" context state state_descr line
  local subcommand="${words[2]}"
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[show help]' \
    '1:command:->command' \
    '*::args:->args' && return 0

  if [[ "${state}" == command ]]; then
    local -a commands
    commands=(
      'list:list encrypted env names'
      'get:decrypt one env entry and print value'
      'set:add or update one env entry'
      'unset:remove one env entry'
      'unlock:unlock local access by verifying master password'
      'passwd:set or rotate master password'
      'sync:refresh local env.zsh from encrypted data'
    )
    _describe -t commands 'command' commands
    return 0
  fi

  # *::args restricts words/CURRENT to the subcommand and its arguments.
  case "${subcommand}" in
    list)
      _arguments \
        '(-h --help)'{-h,--help}'[show help]' \
        '--values[decrypt and print all values]'
      ;;
    get|unset)
      _arguments \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:env name:_q_secret_env_names'
      ;;
    set)
      local ret=1
      _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '(2)--stdin[read exact value from standard input]' \
        '1:env name:_q_secret_env_names' \
        '(--stdin)2::env value:->value' && ret=0
      if [[ "$state" == value && "$PREFIX" != -* ]]; then
        _message 'env value (omit for hidden input)'
      fi
      return ret
      ;;
    unlock|passwd|sync)
      _arguments '(-h --help)'{-h,--help}'[show help]'
      ;;
  esac
}

_q_secret_env "$@"
