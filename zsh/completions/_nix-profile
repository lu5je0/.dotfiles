#compdef nix

autoload -Uz _nix

if [[ ${words[2]} == profile && ${words[3]} == (add|upgrade|remove) && CURRENT -ge 4 && $PREFIX != -* ]]; then
  local curcontext="$curcontext" context state state_descr line
  local -A opt_args

  # Let Nix handle option values; only extend positional package completion.
  _arguments -C \
    '1:command:' \
    '2:profile command:' \
    '--profile=:profile:->native' \
    '--regex=:pattern:->native' \
    '--priority=:priority:->native' \
    '--all[match all packages]' \
    '*:package:->package'

  if [[ $state == package ]]; then
    case ${words[3]} in
      upgrade|remove)
        local -a profile_args packages
        if [[ -n ${opt_args[--profile]} ]]; then
          profile_args=(--profile "${(Q)opt_args[--profile]}")
        fi
        packages=(${(f)"$(command nix profile list "${profile_args[@]}" --json 2>/dev/null |
          command jq -r '.elements | keys[]' 2>/dev/null)"})
        compadd -a packages
        return
        ;;
      add)
        if [[ $PREFIX$SUFFIX != *\#* && $PREFIX != [./~]* ]]; then
          compadd -Q -S '' -- 'nixpkgs#' 'nixpkgs-unstable#' && return
        fi
        if [[ $PREFIX$SUFFIX == *\#* ]]; then
          local -a input reply suggestions quoted
          local suggestion
          input=("${(Q)words[@]}")
          reply=("${(@f)$(NIX_GET_COMPLETIONS=$((CURRENT - 1)) "${input[@]}" 2>/dev/null)}")
          if [[ ${reply[1]} == attrs ]]; then
            for suggestion in "${reply[@]:1}"; do
              suggestions+=("${suggestion%%$'\t'*}")
            done
            if [[ -n $compstate[quote] ]]; then
              compadd -J nix -S '' -d suggestions -a suggestions
              return
            fi
            for suggestion in "${suggestions[@]}"; do
              suggestion=${(q)suggestion}
              # Completion enables extendedglob locally; inspect the caller's options.
              if [[ $_comp_caller_options[extendedglob] == off &&
                    $_comp_caller_options[interactivecomments] == off ]]; then
                suggestion=${suggestion//\\\#/#}
              fi
              quoted+=("$suggestion")
            done
            compadd -Q -J nix -S '' -d suggestions -a quoted
            return
          fi
        fi
        ;;
    esac
  fi
fi

_nix "$@"
