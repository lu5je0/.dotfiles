+        fn canonical_key(name: &str) -> (u8, &str) {
+            const CATEGORIES: [&str; 7] = ["cpu", "memory", "disk", "net", "gpu", "fan", "battery"];
+
+            let category = CATEGORIES
+                .iter()
+                .position(|prefix| name.starts_with(prefix))
+                .unwrap_or(CATEGORIES.len()) as u8;
+
+            (category, name)
+        }
