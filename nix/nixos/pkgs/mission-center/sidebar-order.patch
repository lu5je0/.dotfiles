+                "cpu" => "cpu",
+                "memory" => "memory",
+                "disk" => "disk",
+                "net" => "network",
+                "gpu" => "gpu",
+                "fan" => "fan",
+                "battery" => "battery",
+                _ => return None,
+            })
+        }
