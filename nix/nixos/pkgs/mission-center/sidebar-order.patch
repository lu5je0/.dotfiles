+fn prune_sidebar_order(order: &mut Vec<String>, present: &HashSet<String>, max: usize) {
+    let mut excess = order.len().saturating_sub(max);
+    let mut index = order.len();
+
+    while excess > 0 && index > 0 {
+        index -= 1;
+
+        if !present.contains(&order[index]) {
+            order.remove(index);
+            excess -= 1;
+        }
+    }
+}
