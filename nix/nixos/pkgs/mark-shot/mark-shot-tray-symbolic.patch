+void ensureTrayIconVisible()
+{
+#if defined(Q_OS_WIN)
+    return;
+#else
+    const QString source = QCoreApplication::applicationDirPath() +
+        QStringLiteral("/../share/icons/hicolor/symbolic/apps/mark-shot-symbolic.svg");
+    if (!QFile::exists(source)) {
+        return;
+    }
+
+    const QString dataHome = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation);
+    if (dataHome.isEmpty()) {
+        return;
+    }
+
+    const QString targetDir = dataHome + QStringLiteral("/icons/hicolor/symbolic/apps");
+    if (!QDir().mkpath(targetDir)) {
+        return;
+    }
+
+    const QString target = targetDir + QStringLiteral("/mark-shot-symbolic.svg");
+    const QFileInfo targetInfo(target);
+    if (targetInfo.exists() && !targetInfo.isSymLink()) {
+        return;
+    }
+    if (targetInfo.isSymLink()) {
+        QFile::remove(target);
+    }
+    QFile::link(source, target);
+#endif
+}
+
