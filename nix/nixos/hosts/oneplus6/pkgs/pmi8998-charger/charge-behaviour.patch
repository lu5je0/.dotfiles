From: OnePlus 6 local configuration
Subject: power: supply: qcom_smbx: expose charging inhibit independently of USB input

Adapt the CHARGING_ENABLE_CMD idea from the user-provided OnePlus 6 diff
to the standard charge_behaviour ABI. Return register errors, reject
unsupported modes, notify userspace, and restore charging on driver removal.

--- a/qcom_smbx.c
+++ b/qcom_smbx.c
@@ -409,10 +409,56 @@
 	POWER_SUPPLY_PROP_CURRENT_NOW,
 	POWER_SUPPLY_PROP_VOLTAGE_NOW,
 	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR,
 	POWER_SUPPLY_PROP_HEALTH,
 	POWER_SUPPLY_PROP_ONLINE,
 	POWER_SUPPLY_PROP_USB_TYPE,
 };
+
+static int smb_get_charge_behaviour(struct smb_chip *chip, int *val)
+{
+	unsigned int reg;
+	int ret;
+
+	ret = regmap_read(chip->regmap, chip->base + CHARGING_ENABLE_CMD, &reg);
+	if (ret)
+		return ret;
+
+	*val = (reg & CHARGING_ENABLE_CMD_BIT) ?
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO :
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+	return 0;
+}
+
+static int smb_set_charge_behaviour(struct smb_chip *chip, int behaviour)
+{
+	unsigned int enable;
+
+	switch (behaviour) {
+	case POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO:
+		enable = CHARGING_ENABLE_CMD_BIT;
+		break;
+	case POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE:
+		enable = 0;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* Keep USBIN and the existing temperature/voltage protections enabled. */
+	return regmap_update_bits(chip->regmap, chip->base + CHARGING_ENABLE_CMD,
+				  CHARGING_ENABLE_CMD_BIT, enable);
+}
+
+static void smb_restore_charging(void *data)
+{
+	struct smb_chip *chip = data;
+	int ret;
+
+	ret = smb_set_charge_behaviour(chip, POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO);
+	if (ret)
+		dev_warn(chip->dev, "Couldn't restore normal charging: %d\n", ret);
+}
 
 static int smb_get_prop_usb_online(struct smb_chip *chip, int *val)
 {
