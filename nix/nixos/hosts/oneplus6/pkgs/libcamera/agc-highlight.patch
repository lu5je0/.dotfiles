+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <numeric>
+
+namespace libcamera {
+
+/* Full RAW channel histograms, independent of the trimmed AWB samples.
+ * Ignore the brightest 2% (small lamps/specular reflections), then reserve
+ * 15% linear headroom after black subtraction and white balance. This limits
+ * real sensor exposure before clipping; it does not darken rendered pixels.
+ */
+struct ExposureStats {
+    std::array<std::array<uint32_t, 64>, 3> histogram{};
+
+    void add(unsigned int r, unsigned int g, unsigned int b)
+    {
+        ++histogram[0][std::min(r, 255u) / 4];
+        ++histogram[1][std::min(g, 255u) / 4];
+        ++histogram[2][std::min(b, 255u) / 4];
+    }
+
+    void merge(const ExposureStats &other)
+    {
+        for (unsigned int c = 0; c < 3; ++c)
+            for (unsigned int i = 0; i < 64; ++i)
+                histogram[c][i] += other.histogram[c][i];
+    }
+
+    double highlight(unsigned int black, const std::array<float, 3> &gains) const
+    {
+        if (black >= 255)
+            return 0.0;
+        double value = 0.0;
+        for (unsigned int c = 0; c < 3; ++c) {
+            const uint64_t count = std::accumulate(histogram[c].begin(),
+                                                  histogram[c].end(), uint64_t{0});
+            if (count < 64 || !std::isfinite(gains[c]) || gains[c] <= 0)
+                continue;
+            const uint64_t rank = (count * 98 + 99) / 100;
+            uint64_t sum = 0;
+            for (unsigned int i = 0; i < 64; ++i) {
+                sum += histogram[c][i];
+                if (sum < rank)
+                    continue;
+                /* Upper bin edge avoids underestimating clipped samples. */
+                const double linear = std::max(0.0, double(i * 4 + 3) - black);
+                value = std::max(value, linear * gains[c] / (255 - black));
+                break;
+            }
+        }
+        return value;
+    }
+};
+
+inline double exposureCorrection(double msv, double highlight)
+{
+    if (!std::isfinite(msv) || !std::isfinite(highlight) || msv <= 0 || highlight < 0)
+        return 1.0;
+    const double error = 2.5 - msv;
+    double factor = std::abs(error) <= 0.2 ? 1.0 : 1.0 + error * 0.04;
+    constexpr double target = 0.85;
+    /* A small dead band covers the 4-code histogram quantization. Always
+     * allow normal metering to decrease exposure, even inside this band.
+     */
+    if (highlight >= target * 0.98 && highlight <= target * 1.02)
+        factor = std::min(factor, 1.0);
+    else if (highlight > 0)
+        factor = std::min(factor, target / highlight);
+    return std::clamp(factor, 0.85, 1.15);
+}
+
+} /* namespace libcamera */
