+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+namespace libcamera {
+
+/* AWB must not include channel-clipped samples: the clipped green plane
+ * otherwise underestimates both R/G and B/G correction under bright lights.
+ * Values are normalized to the same 8-bit range used by software ISP BLC.
+ */
+struct AwbAccumulator {
+    std::array<uint64_t, 3> sum{};
+    uint64_t count = 0;
+
+    void add(unsigned int r, unsigned int g, unsigned int b)
+    {
+        if (std::min({r, g, b}) <= 24 || std::max({r, g, b}) >= 240)
+            return;
+        sum[0] += r;
+        sum[1] += g;
+        sum[2] += b;
+        ++count;
+    }
+
+    void merge(const AwbAccumulator &other)
+    {
+        for (unsigned int i = 0; i < 3; ++i)
+            sum[i] += other.sum[i];
+        count += other.count;
+    }
+
+    bool gains(unsigned int blackLevel, std::array<float, 3> &result) const
+    {
+        const uint64_t offset = count * blackLevel;
+        if (count < 64 || std::min({sum[0], sum[1], sum[2]}) <= offset)
+            return false;
+        const double r = sum[0] - offset;
+        const double g = sum[1] - offset;
+        const double b = sum[2] - offset;
+        result = {static_cast<float>(std::min(4.0, g / r)), 1.0f,
+                  static_cast<float>(std::min(4.0, g / b))};
+        return true;
+    }
+};
+
+} /* namespace libcamera */
