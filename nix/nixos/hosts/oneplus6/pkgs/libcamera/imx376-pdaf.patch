+#if defined(IMX376_PDAF)
+float imx376_raw(vec2 pixel)
+{
+ pixel = clamp(pixel, vec2(0.0), tex_size - vec2(1.0));
+ vec2 bytes = vec2(floor(BPP * pixel.x + 0.02) + 0.5, pixel.y + 0.5) * tex_step;
+ return texture2D(tex_y, bytes).r;
+}
+float imx376_fetch(vec2 pixel)
+{
+ pixel = clamp(floor(pixel), vec2(0.0), tex_size - vec2(1.0));
+ vec2 native = pixel;
+ if (tex_bayer_first_red.x > 0.5) native.x = tex_size.x - 1.0 - pixel.x;
+ if (tex_bayer_first_red.y > 0.5) native.y = tex_size.y - 1.0 - pixel.y;
+ float row = mod(native.y, 16.0);
+ bool affected = ((row == 1.0 || row == 13.0) && mod(native.x, 8.0) == 1.0) ||
+                 ((row == 5.0 || row == 9.0) && mod(native.x, 8.0) == 5.0);
+ if (!affected) return imx376_raw(pixel);
+ if (pixel.x < 2.0) return imx376_raw(pixel + vec2(2.0, 0.0));
+ if (pixel.x + 2.0 >= tex_size.x) return imx376_raw(pixel - vec2(2.0, 0.0));
+ return 0.5 * (imx376_raw(pixel - vec2(2.0, 0.0)) + imx376_raw(pixel + vec2(2.0, 0.0)));
+}
+#endif
