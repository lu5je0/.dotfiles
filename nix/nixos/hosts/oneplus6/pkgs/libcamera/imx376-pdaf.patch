+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* OnePlus 6 IMX376K 2592x1940: measured binned PDAF pixel positions. */
+#pragma once
+
+namespace libcamera {
+inline bool imx376PdafPixel(unsigned int x, unsigned int y,
+                           unsigned int width, unsigned int height,
+                           bool hflip, bool vflip)
+{
+ if (width != 2592 || height != 1940)
+  return false;
+ if (hflip)
+  x = width - 1 - x;
+ if (vflip)
+  y = height - 1 - y;
+ const unsigned int row = y % 16;
+ return ((row == 1 || row == 13) && x % 8 == 1) ||
+        ((row == 5 || row == 9) && x % 8 == 5);
+}
+
+template<typename Reader>
+unsigned int imx376CorrectedPixel(unsigned int x, unsigned int y,
+                                 unsigned int width, unsigned int height,
+                                 bool hflip, bool vflip, Reader read)
+{
+ if (!imx376PdafPixel(x, y, width, height, hflip, vflip))
+  return read(x, y);
+ /* Horizontal neighbours two pixels away have the same Bayer colour. */
+ if (x < 2)
+  return read(x + 2, y);
+ if (x + 2 >= width)
+  return read(x - 2, y);
+ return (read(x - 2, y) + read(x + 2, y) + 1) / 2;
+}
+} /* namespace libcamera */
