+void SwStatsCpu::processImx376Frame(MappedFrameBuffer &in)
+{
+ const uint8_t *data = in.planes()[0].data();
+ const bool hflip = imx376Order_ == BayerFormat::GRBG || imx376Order_ == BayerFormat::BGGR;
+ const bool vflip = imx376Order_ == BayerFormat::GBRG || imx376Order_ == BayerFormat::BGGR;
+ auto read = [&](unsigned int x, unsigned int y) -> unsigned int {
+  return data[y * stride_ + (x / 4) * 5 + x % 4];
+ };
+ auto pixel = [&](unsigned int x, unsigned int y) {
+  return imx376CorrectedPixel(x, y, inputSize_.width, inputSize_.height,
+                             hflip, vflip, read);
+ };
+ SwIspStats &stats = stats_[0];
+ for (unsigned int y = window_.y; y + 1 < window_.y + window_.height; y += 4) {
+  SWSTATS_START_LINE_STATS(unsigned int)
+  for (unsigned int x = window_.x; x + 1 < window_.x + window_.width; x += 4) {
+   r = pixel(x + hflip, y + vflip);
+   b = pixel(x + !hflip, y + !vflip);
+   g = (pixel(x + !hflip, y + vflip) + pixel(x + hflip, y + !vflip)) / 2;
+   SWSTATS_ACCUMULATE_LINE_STATS(1)
+  }
+  SWSTATS_FINISH_LINE_STATS()
+ }
+}
