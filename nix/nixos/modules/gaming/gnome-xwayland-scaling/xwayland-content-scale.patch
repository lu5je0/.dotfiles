Subject: [PATCH] x11: publish fractional content scale separately from GTK UI scale

diff --git a/data/dbus-interfaces/org.gnome.Mutter.X11.xml b/data/dbus-interfaces/org.gnome.Mutter.X11.xml
--- a/data/dbus-interfaces/org.gnome.Mutter.X11.xml
+++ b/data/dbus-interfaces/org.gnome.Mutter.X11.xml
@@ -4,5 +4,7 @@
 <node>
   <interface name="org.gnome.Mutter.X11">
     <property name="UiScalingFactor" type="i" access="readwrite" />
+    <!-- Fractional DPI for XResources consumers; GTK window scales stay integral. -->
+    <property name="ContentScalingFactor" type="d" access="read" />
   </interface>
 </node>
diff --git a/src/x11/meta-x11-display.c b/src/x11/meta-x11-display.c
--- a/src/x11/meta-x11-display.c
+++ b/src/x11/meta-x11-display.c
@@ -208,7 +208,12 @@
   int ui_scaling_factor =
     meta_xwayland_get_x11_ui_scaling_factor (xwayland_manager);
 
+  double content_scaling_factor =
+    meta_xwayland_get_x11_content_scaling_factor (xwayland_manager);
+
   meta_dbus_x11_set_ui_scaling_factor (priv->dbus_api, ui_scaling_factor);
+  meta_dbus_x11_set_content_scaling_factor (priv->dbus_api,
+                                           content_scaling_factor);
 }
 
 static void
