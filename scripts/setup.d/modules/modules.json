[
  { "name": "zshrc", "source": "zshrc", "target": "~/.zshrc" },
  { "name": "nvim", "source": "vim", "target": "~/.config/nvim" },
  { "name": "ssh", "source": "ssh/config", "target": "~/.ssh/config" },
  { "name": "git", "source": "git", "target": "~/.config/git" },
  { "name": "maven", "source": "m2/settings.xml", "target": "~/.m2/settings.xml" },
  { "name": "ideavimrc", "source": "ideavimrc", "target": "~/.ideavimrc" },
  { "name": "tmux", "source": "tmux", "target": "~/.config/tmux" },
  { "name": "ghostty", "source": "ghostty", "target": "~/.config/ghostty" },
  { "name": "wezterm", "source": "wezterm", "target": "~/.config/wezterm" },
  { "name": "yazi", "source": "yazi", "target": "~/.config/yazi" },
  { "name": "kitty", "source": "kitty", "target": "~/.config/kitty" },
  {
    "name": "pi",
    "action": "install",
    "desc": "pi 配置",
    "script": "unix/pi.sh",
    "checks": [{ "link": "~/.pi/agent/extensions" }]
  },
  {
    "name": "q-trash",
    "action": "link",
    "desc": "q-trash → ~/.local/bin",
    "script": "unix/q-trash.sh",
    "checks": [{ "link": "~/.local/bin/q-trash" }]
  },
  {
    "name": "rime-ime",
    "action": "install",
    "desc": "fcitx5/Squirrel + Rime, shallow-clone rime-ice (ime/install.sh)",
    "script": "unix/rime-ime.sh",
    "vars": {
      "RIME_DIR": { "mac": "~/Library/Rime", "linux": "~/.local/share/fcitx5/rime" }
    },
    "checks": [
      { "link": "$RIME_DIR/rime_ice.custom.yaml" },
      { "link": "$RIME_DIR/rime.lua" },
      { "link": "$RIME_DIR/custom_phrase.txt" },
      { "exists": "$RIME_DIR/rime-ice/default.yaml" },
      { "exists": "$RIME_DIR/cn_dicts" },
      { "link": "~/.config/fcitx5", "os": ["linux"] },
      { "link": "~/.config/fontconfig/conf.d/75-noto-emoji-over-symbols2.conf", "os": ["linux"] }
    ],
    "os": ["mac", "linux"]
  },
  {
    "name": "nerd-font",
    "action": "install",
    "desc": "JetBrainsMonoNL Nerd Font Mono Regular (Windows user fonts on WSL)",
    "script": "unix/nerd-font.sh",
    "vars": {
      "FONT": {
        "wsl": "$WIN_HOME/AppData/Local/Microsoft/Windows/Fonts/JetBrainsMonoNLNerdFontMono-Regular.ttf",
        "mac": "~/Library/Fonts/JetBrainsMonoNLNerdFontMono-Regular.ttf",
        "termux": "~/.termux/font.ttf",
        "linux": "~/.local/share/fonts/JetBrainsMonoNLNerdFontMono-Regular.ttf"
      }
    },
    "checks": [{ "exists": "$FONT" }]
  },
  {
    "name": "hammerspoon",
    "source": "hammerspoon",
    "target": "~/.hammerspoon",
    "os": ["mac"]
  },
  {
    "name": "karabiner",
    "source": "karabiner",
    "target": "~/.config/karabiner",
    "os": ["mac"]
  },
  {
    "name": "termux",
    "action": "link",
    "desc": "termux config (~/.config/termux)",
    "script": "unix/termux.sh",
    "checks": [{ "link": "~/.config/termux" }],
    "os": ["termux"]
  },
  {
    "name": "waybar",
    "source": "wm/waybar",
    "target": "~/.config/waybar",
    "os": ["linux"]
  },
  { "name": "niri", "source": "wm/niri", "target": "~/.config/niri", "os": ["linux"] },
  {
    "name": "quickshell",
    "source": "wm/quickshell",
    "target": "~/.config/quickshell",
    "os": ["linux"]
  },
  {
    "name": "kwin-tilewindow",
    "action": "install",
    "desc": "KWin tilewindow script (kpackagetool6)",
    "script": "unix/kwin-tilewindow.sh",
    "checks": [{ "exists": "~/.local/share/kwin/scripts/tilewindow" }],
    "os": ["linux"]
  },
  {
    "name": "gnome-tilewindow",
    "action": "install",
    "desc": "GNOME Shell tilewindow extension (symlink + enable)",
    "script": "unix/gnome-tilewindow.sh",
    "checks": [{ "link": "~/.local/share/gnome-shell/extensions/tilewindow@lu5je0" }],
    "os": ["linux"]
  },
  {
    "name": "keyd",
    "action": "symlink",
    "desc": "keyd config → /etc/keyd/default.conf (needs sudo)",
    "script": "unix/keyd.sh",
    "checks": [{ "link": "/etc/keyd/default.conf" }],
    "os": ["linux"]
  },
  {
    "name": "nas-mount",
    "action": "install",
    "desc": "NAS CIFS automount → /etc/fstab (needs sudo)",
    "script": "unix/nas-mount.sh",
    "checks": [
      { "exists": "/run/systemd/generator/mnt-st2000.automount" },
      { "exists": "/run/systemd/generator/mnt-mg08.automount" },
      { "exists": "/run/systemd/generator/mnt-share.automount" }
    ],
    "os": ["linux"]
  },
  {
    "name": "wezterm-win",
    "action": "link",
    "desc": "WezTerm config (Windows side junction)",
    "script": "win/wezterm.sh",
    "checks": [{ "link": "$WIN_HOME/.config/wezterm" }],
    "os": ["win"]
  },
  {
    "name": "gitconfig",
    "action": "link",
    "desc": "gitconfig (Windows side symlink)",
    "script": "win/gitconfig.sh",
    "checks": [{ "link": "$WIN_HOME/.gitconfig" }],
    "os": ["win"]
  },
  {
    "name": "wslconfig",
    "action": "link",
    "desc": "wslconfig (Windows side symlink)",
    "script": "win/wslconfig.sh",
    "checks": [{ "link": "$WIN_HOME/.wslconfig" }],
    "os": ["win"]
  },
  {
    "name": "neovide",
    "action": "link",
    "desc": "neovide config.toml (Windows side symlink)",
    "script": "win/neovide.sh",
    "checks": [{ "link": "$WIN_HOME/AppData/Roaming/neovide/config.toml" }],
    "os": ["win"]
  }
]
