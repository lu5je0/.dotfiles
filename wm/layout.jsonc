{
  // 窗口布局统一配置（JSONC，支持注释）
  // rules 从前往后匹配，取第一条「wm/app/screen 字段全匹配且 size 提供该 mode」的规则；
  // 字段缺省即通配，可为字符串或数组。最后一条无字段规则是全局 fallback。
  "rules": [
    // ---------- hammerspoon (macOS)：screen 分 main / external ----------
    {
      "wm": "hammerspoon",
      "app": "WezTerm",
      "screen": "main",
      "size": {
        "center_i": { "w": 1126, "h": 862 },
        "center_j": { "w": 1000, "h": 825 }
      }
    },
    {
      "wm": "hammerspoon",
      "app": "WezTerm",
      "screen": "external",
      "size": {
        "center_i": {
          "w": { "ratio": 0.75, "offset": -27 },
          "h": { "ratio": 1, "offset": -24 }
        },
        "center_j": { "w": 1013, "h": 840 }
      }
    },
    {
      "wm": "hammerspoon",
      "app": "kitty",
      "screen": "main",
      "size": {
        "center_i": { "w": 1251, "h": 863, "x": { "offset": 30 } },
        "center_j": { "w": 989, "h": 807, "x": { "offset": 30 } }
      }
    },
    {
      "wm": "hammerspoon",
      "app": "kitty",
      "screen": "external",
      "size": {
        "center_i": { "w": 1420, "h": 992 },
        "center_j": { "w": 1023, "h": 863 }
      }
    },
    {
      "wm": "hammerspoon",
      "app": "Ghostty",
      "screen": "main",
      "size": {
        "center_i": { "w": 1105, "h": 863 },
        "center_j": { "w": 952, "h": 806 }
      }
    },
    {
      "wm": "hammerspoon",
      "app": "Ghostty",
      "screen": "external",
      "size": {
        "center_i": {
          "w": { "ratio": 0.75, "offset": -20 },
          "h": { "ratio": 1, "offset": -16 }
        },
        "center_j": { "w": 1016, "h": 846 }
      }
    },
    {
      "wm": "hammerspoon",
      "size": {
        "center_i": { "w": { "ratio": 0.9 }, "h": { "ratio": 1 } },
        "center_j": { "w": { "ratio": 0.65 }, "h": { "ratio": 0.85 } },
        "maximize": { "w": { "ratio": 1 }, "h": { "ratio": 1 } },
        "halfleft": { "w": { "ratio": 0.5 }, "h": { "ratio": 1 } },
        "halfright": { "w": { "ratio": 0.5 }, "h": { "ratio": 1 } }
      }
    },
    // ---------- linux (kwin / gnome)：screen 用 default（缺省） ----------
    {
      "wm": ["kwin", "gnome"],
      "app": "kitty",
      "size": {
        "center_i": { "w": 1727, "h": 1145 },
        "center_j": { "w": 1113, "h": 945 }
      }
    },
    {
      // 全局 fallback（无字段规则，所有平台通用）
      "size": {
        "center_i": {
          "w": { "ratio": 0.6875 },
          "h": { "ratio": 1, "offset": -120 },
          "y": { "align": "top", "offset": 23 }
        },
        "center_j": { "w": { "ratio": 0.6 }, "h": { "ratio": 0.85 } }
      }
    }
  ],
  // 左右贴边尺寸（kwin/gnome 共用）
  "side": { "width": 1139, "height": 1218 },
  // gnome 手动 insets（top/bottom/left/right），一般留空
  "insets": {}
}
