#!/usr/bin/env bash
# xclip shim for WSL: bridges clipboard requests to the Windows clipboard so
# tools like qodercli can paste images without an X server.
set -u

PS=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe

target=""
out=0
args=("$@")
n=$#
i=0
while [ "$i" -lt "$n" ]; do
  case "${args[$i]}" in
    -selection|-sel|-display|-d) i=$((i+1)) ;;
    -t|-target) i=$((i+1)); target="${args[$i]:-}" ;;
    -o|-out) out=1 ;;
    -i|-in) out=0 ;;
  esac
  i=$((i+1))
done

ps_run() {
  "$PS" -NoProfile -NonInteractive -STA -Command "$1" 2>/dev/null
}

if [ "$out" -eq 1 ]; then
  case "$target" in
    TARGETS)
      ps_run '
        Add-Type -AssemblyName System.Windows.Forms | Out-Null
        if ([System.Windows.Forms.Clipboard]::ContainsImage()) { "image/png" }
        if ([System.Windows.Forms.Clipboard]::ContainsText())  { "UTF8_STRING`nSTRING`ntext/plain" }
      ' | tr -d '\r'
      exit 0
      ;;
    image/png|image/*)
      [ "$target" = "image/png" ] || exit 1
      f=$(ps_run '
        Add-Type -AssemblyName System.Windows.Forms | Out-Null
        Add-Type -AssemblyName System.Drawing | Out-Null
        $img = [System.Windows.Forms.Clipboard]::GetImage()
        if ($img -eq $null) { exit 1 }
        $f = [System.IO.Path]::Combine([System.IO.Path]::GetTempPath(), "wslclip-" + [guid]::NewGuid().ToString() + ".png")
        $img.Save($f, [System.Drawing.Imaging.ImageFormat]::Png)
        Write-Output $f
      ' | tr -d '\r')
      [ -n "${f:-}" ] || exit 1
      wf=$(wslpath -u "$f") || exit 1
      [ -s "$wf" ] || { rm -f "$wf"; exit 1; }
      cat "$wf"
      rm -f "$wf"
      exit 0
      ;;
    *)
      ps_run 'Get-Clipboard -Raw' | sed -e 's/\r$//'
      exit 0
      ;;
  esac
else
  # copy: stdin -> Windows clipboard
  exec /mnt/c/Windows/System32/clip.exe
fi
