#!/usr/bin/env bash
# wl-paste shim for WSL: bridges clipboard reads to the Windows clipboard so
# tools like qodercli can paste images without a Wayland compositor.
# If a real wl-paste exists elsewhere in PATH (genuine Wayland setup, e.g.
# wl-clipboard installed under WSLg), defer to it.
set -u

self=$(readlink -f "$0")
while IFS= read -r p; do
  if [ "$(readlink -f "$p")" != "$self" ]; then
    exec "$p" "$@"
  fi
done < <(type -aP wl-paste)

PS=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe

list=0
mime=""
while [ $# -gt 0 ]; do
  case "$1" in
    --list-types|-l) list=1 ;;
    --type|-t) shift; mime="${1:-}" ;;
    --type=*) mime="${1#--type=}" ;;
  esac
  shift
done

ps_run() {
  "$PS" -NoProfile -NonInteractive -STA -Command "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; $1" 2>/dev/null
}

if [ "$list" -eq 1 ]; then
  ps_run '
    Add-Type -AssemblyName System.Windows.Forms | Out-Null
    if ([System.Windows.Forms.Clipboard]::ContainsImage()) { "image/png" }
    if ([System.Windows.Forms.Clipboard]::ContainsText())  { "text/plain`ntext/plain;charset=utf-8`nUTF8_STRING`nSTRING" }
  ' | tr -d '\r'
  exit 0
fi

case "$mime" in
  image/png)
    f=$(ps_run '
      Add-Type -AssemblyName System.Windows.Forms | Out-Null
      Add-Type -AssemblyName System.Drawing | Out-Null
      $img = [System.Windows.Forms.Clipboard]::GetImage()
      if ($img -eq $null) { exit 1 }
      $f = [System.IO.Path]::Combine([System.IO.Path]::GetTempPath(), "wslclip-" + [guid]::NewGuid().ToString() + ".png")
      $img.Save($f, [System.Drawing.Imaging.ImageFormat]::Png)
      Write-Output $f
    ' | tr -d '\r')
    [ -n "${f:-}" ] || exit 1
    wf=$(wslpath -u "$f") || exit 1
    [ -s "$wf" ] || { rm -f "$wf"; exit 1; }
    cat "$wf"
    rm -f "$wf"
    exit 0
    ;;
  image/*)
    exit 1
    ;;
  *)
    ps_run 'Get-Clipboard -Raw' | sed -e 's/\r$//'
    exit 0
    ;;
esac
