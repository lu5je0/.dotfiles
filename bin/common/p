#!/usr/bin/env python3
import base64
import binascii
import json
import os
import shutil
import subprocess
import sys

USAGE = """Usage: p [options]

Paste clipboard content to stdout.

Options:
  -f    Force output even if stdout is a terminal (for binary data)
  -h    Show this help message

Examples:
  p              Paste text
  p > 1.png      Save clipboard image to file
  p | vv         Display clipboard image in terminal
  p -f           Force binary output to terminal
"""

DOTFILES_DIR = os.environ.get('DOTFILES_DIR') or os.path.expanduser('~/.dotfiles')
WCLIP = os.path.join(DOTFILES_DIR, 'bin', 'windows-x86_64', 'wclip.exe')


def die(message):
    sys.stderr.write('p: %s\n' % message)
    sys.exit(1)


def has_image(cmd):
    out = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
    return any(t.startswith(b'image/') for t in out.splitlines())


def is_wsl():
    try:
        with open('/proc/version') as f:
            return 'microsoft' in f.read().lower()
    except OSError:
        return False


def bridge_request(bridge, method):
    request = {'id': 1, 'module': 'clipboard', 'method': method, 'params': {}}
    try:
        process = subprocess.run(
            [bridge, '-j', json.dumps(request)], stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10,
        )
        if process.returncode:
            die('tui-bridge failed: %s' % process.stderr.decode('utf-8', 'replace').strip())
        response = json.loads(process.stdout)
        if not isinstance(response, dict) or response.get('id') != 1:
            raise ValueError('invalid response')
        if response.get('ok') is not True:
            error = response.get('error', {})
            if isinstance(error, dict) and error.get('code') == 'INVALID_METHOD':
                die('tui-bridge lacks image support; rebuild module/tui-bridge and install it in ~/.local/bin')
            die('tui-bridge: %s' % error)
        result = response.get('result')
        if not isinstance(result, dict):
            raise ValueError('invalid result')
        return result
    except (OSError, subprocess.TimeoutExpired, ValueError) as error:
        die('tui-bridge: %s' % error)


def paste_bridge(bridge, raw):
    result = bridge_request(bridge, 'image')
    image = result.get('data')
    if result.get('mime') != 'image/png' or not isinstance(image, str):
        die('invalid image response from tui-bridge')
    if image:
        if not raw:
            die('clipboard contains image data, use -f to force output or redirect to a file')
        try:
            sys.stdout.buffer.write(base64.b64decode(image, validate=True))
        except (ValueError, binascii.Error):
            die('invalid image data from tui-bridge')
    else:
        text = bridge_request(bridge, 'output').get('text')
        if not isinstance(text, str):
            die('invalid text response from tui-bridge')
        sys.stdout.buffer.write(text.encode('utf-8'))
    sys.exit(0)


force = False
for arg in sys.argv[1:]:
    for flag in arg[1:] if arg.startswith('-') else '?':
        if flag == 'f':
            force = True
        else:
            sys.stdout.write(USAGE)
            sys.exit(0 if flag == 'h' else 1)

raw = force or not sys.stdout.isatty()

if (os.environ.get('SSH_CLIENT') or os.environ.get('SSH_TTY')) and shutil.which('clipboard-osc52'):
    os.execvp('clipboard-osc52', ['clipboard-osc52', 'paste'])

if sys.platform == 'darwin':
    bridge = shutil.which('tui-bridge')
    if not bridge:
        installed = os.path.expanduser('~/.local/bin/tui-bridge')
        if os.access(installed, os.X_OK):
            bridge = installed
    if bridge:
        paste_bridge(bridge, raw)

if sys.platform == 'darwin' and shutil.which('mac_clipboard_cli'):
    os.execvp('mac_clipboard_cli', ['mac_clipboard_cli', '-p'])

if sys.platform.startswith('linux') and is_wsl():
    if not raw:
        detect = subprocess.run(
            [WCLIP, 'paste', '--detect'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        cb_type = detect.stdout.decode('utf-8', 'replace').strip()
        if cb_type in ('image', 'file'):
            die('clipboard contains %s data, use -f to force output or redirect to a file' % cb_type)
        if cb_type != 'text':
            die('clipboard is empty')
    os.execvp(WCLIP, [WCLIP, 'paste'])

if os.environ.get('WAYLAND_DISPLAY') and shutil.which('wl-paste'):
    if raw:
        os.execvp('wl-paste', ['wl-paste'])
    if has_image(['wl-paste', '--list-types']):
        die('clipboard contains image data, use -f to force output or redirect to a file')
    os.execvp('wl-paste', ['wl-paste', '--no-newline'])

if os.environ.get('DISPLAY') and shutil.which('xclip'):
    paste = ['xclip', '-selection', 'clipboard', '-o']
    if not raw and has_image(['xclip', '-selection', 'clipboard', '-t', 'TARGETS', '-o']):
        die('clipboard contains image data, use -f to force output or redirect to a file')
    os.execvp('xclip', paste)

die('clipboard backend unavailable')
