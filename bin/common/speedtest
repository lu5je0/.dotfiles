# 测速
# --------------------------------------------------------------------------- #
class _CountingBody:
    """以 memoryview 分块发送请求体，复用原始缓冲区。

    http.client 发送完一个块后才恢复迭代，此时累计已交给 socket 的字节，
    不必等整个请求的响应。stop 置位后不再生成新块。
    """

    def __init__(self, data, add, stop):
        self._data = memoryview(data)
        self._add = add
        self._stop = stop

    def __iter__(self):
        for offset in range(0, len(self._data), IO_CHUNK):
            if self._stop.is_set():
                return
            chunk = self._data[offset:offset + IO_CHUNK]
            yield chunk
            self._add(len(chunk))


def conn_latency(conn, path=PROBE_PATH):
    start = time.monotonic()
    conn.request("GET", path + "?x=%d" % random.getrandbits(30), headers={"User-Agent": USER_AGENT})
    resp = conn.getresponse()
    check_response(resp)
    resp.read()
    return (time.monotonic() - start) * 1000.0


def measure_idle_latency(base, count, probe_path=PROBE_PATH):
    """测量空闲延迟，返回 (样本列表, 失败数, 总探测数)。"""
    conn = make_conn(base)
    samples = []
    failures = 0
    total = count + 1  # 第一个样本作为预热丢弃
    for index in range(total):
        try:
            ms = conn_latency(conn, probe_path)
        except Exception:
            failures += 1
            try:
                conn.close()
            except Exception:
                pass
            conn = make_conn(base)
            continue
        if index > 0:
            samples.append(ms)
    try:
        conn.close()
    except Exception:
        pass
    return samples, failures, total


def _render_progress(label, rate_bps, percent, spin):
    filled = percent * 20 // 100
    body = "=" * filled
    if filled < 20:
        body += SPINNER[spin % 4] + " " * (19 - filled)
    line = "\r%12s: %9.2f Mbps [%s] %3d%%" % (label, rate_bps * 8 / 1e6, body[:20], percent)
    sys.stdout.write(line)
    sys.stdout.flush()


def _clear_progress():
    sys.stdout.write("\r" + " " * 78 + "\r")
    sys.stdout.flush()


def sample_rate(samples, since):
    """计算 since 至最后一次采样的字节速率，边界在相邻采样之间线性插值。"""
    if len(samples) < 2:
        return 0.0
    begin, first_bytes = samples[0]
    for stamp, count in samples[1:]:
        if stamp <= since:
            begin, first_bytes = stamp, count
        else:
            if since > begin:
                first_bytes += (count - first_bytes) * (since - begin) / (stamp - begin)
                begin = since
            break
    end, last_bytes = samples[-1]
    if end <= begin:
        return 0.0
    return max(last_bytes - first_bytes, 0) / (end - begin)


def run_transfer(label, base, duration, thread_count, upload, progress, paths=None,
                 upload_size=UPLOAD_CHUNK, upload_content_type="application/x-www-form-urlencoded"):
    """并发跑一个阶段的下载或上传，返回统计结果。"""
    paths = OOKLA_PATHS if paths is None else paths
    lock = threading.Lock()
    counter = {"bytes": 0}
    latencies = []
    errors = []
    stop = threading.Event()
    buf = os.urandom(upload_size) if upload else None
    start = time.monotonic()
    samples = [(start, 0)]

    def add(n):
        with lock:
            counter["bytes"] += n

    def total():
        with lock:
            return counter["bytes"]

    def snapshot():
        with lock:
            return time.monotonic(), counter["bytes"]

    def worker():
        conn = None
        download_buf = bytearray(IO_CHUNK) if not upload else None
        while not stop.is_set():
            try:
                if conn is None:
                    conn = make_conn(base)
                if upload:
                    conn.request(
                        "POST",
                        paths["upload"],
                        body=_CountingBody(buf, add, stop),
                        headers={
                            "User-Agent": USER_AGENT,
                            "Content-Type": upload_content_type,
                            "Content-Length": str(len(buf)),
                        },
                    )
                    if stop.is_set():
                        # body 被截断，请求不完整，直接关连接
                        try:
                            conn.close()
                        except Exception:
                            pass
                        conn = None
                        break
                    resp = conn.getresponse()
                    check_response(resp)
                    resp.read()
                else:
                    conn.request(
                        "GET",
                        paths["download"] + ("&" if "?" in paths["download"] else "?")
                        + "x=%d" % random.getrandbits(30),
                        headers={"User-Agent": USER_AGENT},
                    )
                    resp = conn.getresponse()
                    check_response(resp)
                    while not stop.is_set():
                        size = resp.readinto(download_buf)
                        if not size:
                            break
                        add(size)
            except Exception as exc:
                if isinstance(exc, RuntimeError):
                    with lock:
                        errors.append(str(exc))
                    stop.set()
                try:
                    if conn is not None:
                        conn.close()
                except Exception:
                    pass
                conn = None
                if stop.is_set():
                    break
                time.sleep(0.2)
        try:
            if conn is not None:
                conn.close()
        except Exception:
            pass

    def sampler():
        spin = 0
        while not stop.wait(0.1):
            now, current = snapshot()
            samples.append((now, current))
            if progress:
                rate = sample_rate(samples, now - RATE_WINDOW)
                if current > 0:
                    percent = min(99, int((now - start) / duration * 100)) if duration else 0
                else:
                    # 没有实际流量时只显示 spinner。
                    percent = 0
                _render_progress(label, rate, percent, spin)
                spin += 1

    def prober():
        # 独立的探测线程，避免延迟探测阻塞进度条刷新
        conn = None
        while not stop.is_set():
            try:
                if conn is None:
                    conn = make_conn(base)
                latencies.append(conn_latency(conn, paths["latency"]))
            except Exception:
                try:
                    if conn is not None:
                        conn.close()
                except Exception:
                    pass
                conn = None
            stop.wait(0.75)
        try:
            if conn is not None:
                conn.close()
        except Exception:
            pass

    workers = [threading.Thread(target=worker, daemon=True) for _ in range(thread_count)]
    mon = threading.Thread(target=sampler, daemon=True)
    probe_thread = threading.Thread(target=prober, daemon=True)
    for thread in workers:
        thread.start()
    mon.start()
    probe_thread.start()

    deadline = start + duration
    while not stop.is_set():
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        stop.wait(min(remaining, 0.1))
    stop.set()
    end_sample = snapshot()
    mon.join(timeout=3)
    probe_thread.join(timeout=3)
    join_deadline = time.monotonic() + 3
    for thread in workers:
        thread.join(timeout=max(0.0, join_deadline - time.monotonic()))

    elapsed = end_sample[0] - start
    total_bytes = total()
    # 冻结停止传输时的快照，排除收尾等待与在途块稍后完成带来的计数。
    final_samples = [sample for sample in samples if sample[0] < end_sample[0]] + [end_sample]
    warmup = WARMUP_SECONDS if duration > WARMUP_SECONDS else 0.0
    speed = sample_rate(final_samples, start + warmup)

    if progress:
        _clear_progress()
    if errors:
        raise RuntimeError("%s failed: %s" % (label, errors[0]))
    if not total_bytes:
        raise RuntimeError("%s failed: 未传输数据" % label)
    return {"bytes": total_bytes, "speed": speed, "latency": latencies, "elapsed": elapsed}


def print_speed_line(label, speed_bps, data_bytes):
    print("%12s: %8.2f Mbps (data used: %s)" % (label, speed_bps * 8 / 1e6, human_bytes(data_bytes)))


def print_loaded_latency(samples):
    if not samples:
        return
    low, high, mean, jitter = latency_stats(samples)
    print("%12s  %8.2f ms   (jitter: %.2fms, low: %.2fms, high: %.2fms)"
          % ("", mean, jitter, low, high))


def try_save_result(cfg, payload):
    """尽力把结果保存到 speedtest.net，失败返回 None。"""
    app = cfg.get("app", {})
    url = app.get("saveTestResultUrl") or REPORT_URL
    key = app.get("licenseKey")
    try:
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "User-Agent": USER_AGENT,
                "Content-Type": "application/json",
                "Accept": "application/json",
                "X-License-Key": key or "",
            },
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8", "replace"))
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    inner = data.get("result") if isinstance(data.get("result"), dict) else {}
    if inner.get("url"):
        return inner["url"]
    rid = data.get("resultid") or data.get("resultId") or data.get("id") or inner.get("id")
    return "https://www.speedtest.net/result/c/%s" % rid if rid else None


# --------------------------------------------------------------------------- #
# 主流程
# --------------------------------------------------------------------------- #
def main(argv):
    parser = argparse.ArgumentParser(
        prog="speedtest",
        description="Ookla / LibreSpeed 命令行测速",
        add_help=True,
    )
    target = parser.add_mutually_exclusive_group()
    target.add_argument("-s", "--server-id", metavar="ID", help="指定 Ookla 服务器 id")
    target.add_argument("-L", "--servers", action="store_true", help="列出最近的 Ookla 服务器")
    target.add_argument("--librespeed", nargs="?", const=DEFAULT_LIBRESPEED_URL, metavar="URL",
                        help="指定 speedtest-x / LibreSpeed 节点，省略地址时默认 %s" % DEFAULT_LIBRESPEED_URL)
    parser.add_argument("-T", "--threads", nargs="?", type=int, const=4, metavar="N",
                        help="多线程测速，线程数默认 4；不指定则单线程")
    parser.add_argument("-V", "--version", action="version", version="speedtest(py) 1.0")
    args = parser.parse_args(argv)

    paths = OOKLA_PATHS
    if args.librespeed is not None:
        try:
            base, paths = librespeed_target(args.librespeed or DEFAULT_LIBRESPEED_URL)
        except ValueError as exc:
            parser.error(str(exc))
        cfg = {}
    else:
        try:
            cfg = fetch_config(args.server_id)
        except Exception as exc:
            print("speedtest: 获取配置失败: %s" % exc, file=sys.stderr)
            return 1

        servers = [s for s in cfg.get("servers", []) if s.get("host")]
        if not servers:
            print("speedtest: 未找到服务器 (id=%s)" % args.server_id, file=sys.stderr)
            return 1

    if args.servers:
        print("Closest servers:")
        print()
        print("%6s  %-31s%-21s%s" % ("ID", "Name", "Location", "Country"))
        print("=" * 78)
        for item in servers:
            print("%6s  %-31s%-21s%s"
                  % (item.get("id", ""), item.get("sponsor", ""),
                     item.get("name", ""), item.get("country", "")))
        return 0

    stage = cfg.get("suite", {}).get("testStage", {})
    duration = int(os.environ.get("SPEEDTEST_DURATION") or 10)
    if args.threads is not None:
        thread_count = args.threads
    else:
        # 不加 -T 时默认单线程
        thread_count = int(os.environ.get("SPEEDTEST_THREADS") or 1)
    if thread_count < 1:
        print("speedtest: 线程数必须 >= 1", file=sys.stderr)
        return 1
    ping_count = int(stage.get("latency", {}).get("pingCount") or 5)
    isp = cfg.get("app", {}).get("ispName") or "Unknown"

    if args.librespeed is None:
        if args.server_id is not None:
            server, base = servers[0], None
        else:
            try:
                server, base = select_server(cfg)
            except Exception as exc:
                print("Error: %s" % exc, file=sys.stderr)
                return 2
        if base is None:
            try:
                base = resolve_base(server)
            except Exception as exc:
                print("Error: %s" % exc, file=sys.stderr)
                return 2
    progress = sys.stdout.isatty() and not os.environ.get("SPEEDTEST_NO_PROGRESS")

    print()
    print("   Speedtest (LibreSpeed)" if args.librespeed is not None else "   Speedtest by Ookla")
    print()
    if args.librespeed is not None:
        print("      Server: %s" % base)
    else:
        print("      Server: %s - %s (id: %s)"
              % (server.get("sponsor", ""), server.get("name", ""), server.get("id", "")))
        print("         ISP: %s" % isp)

    try:
        idle, failures, probes = measure_idle_latency(base, ping_count, paths["latency"])
    except Exception as exc:
        print("Error: Latency test failed: %s" % exc, file=sys.stderr)
        return 2
    if not idle:
        # 和官方一致：连延迟测试都做不了就直接失败退出
        print("Error: Latency test failed", file=sys.stderr)
        return 2
    low, high, mean, jitter = latency_stats(idle)
    print("%12s: %8.2f ms   (jitter: %.2fms, low: %.2fms, high: %.2fms)"
          % ("Idle Latency", mean, jitter, low, high))

    upload_enabled = stage.get("upload", {}).get("isServerUploadEnabled", True)

    try:
        download = run_transfer("Download", base, duration, thread_count, False, progress, paths)
        print_speed_line("Download", download["speed"], download["bytes"])
        print_loaded_latency(download["latency"])

        if upload_enabled:
            upload = run_transfer(
                "Upload", base, duration, thread_count, True, progress, paths,
                upload_size=LIBRESPEED_UPLOAD_CHUNK if args.librespeed is not None else UPLOAD_CHUNK,
                upload_content_type=("application/octet-stream" if args.librespeed is not None
                                     else "application/x-www-form-urlencoded"),
            )
            print_speed_line("Upload", upload["speed"], upload["bytes"])
            print_loaded_latency(upload["latency"])
        else:
            # 服务端 config 明确禁用上传时不要跑上传阶段
            print("%12s: 已跳过（服务器未开启上传测试）" % "Upload")
    except Exception as exc:
        print("Error: %s" % exc, file=sys.stderr)
        return 2

    loss = (failures / probes * 100.0) if probes else 0.0
    print("%12s: %7.1f%%" % ("Packet Loss", loss))

    if os.environ.get("SPEEDTEST_SAVE") and args.librespeed is None:
        payload = {
            "isp": isp,
            "server": {
                "id": server.get("id"),
                "host": server.get("host", "").split(":")[0],
                "name": server.get("name"),
                "country": server.get("country"),
            },
            "ping": ({"latency": idle[0]} if idle else {}),
            "download": {"bandwidth": int(download["speed"]), "bytes": download["bytes"]},
            "upload": ({"bandwidth": int(upload["speed"]), "bytes": upload["bytes"]}
                       if upload_enabled else {}),
        }
        url = try_save_result(cfg, payload)
        if url:
            print("%12s: %s" % ("Result URL", url))

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print("\nspeedtest: 已中断", file=sys.stderr)
        sys.exit(130)
