#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""speedtest —— Ookla Speedtest 的纯 Python 复刻（默认自动选服 + -s 指定服务器 id）。

用法：
    speedtest              # 自动选择延迟最低的最近服务器并测速（线程数取服务端 config）
    speedtest -s 12191     # 使用指定 id 的服务器
    speedtest -T           # 多线程测速（默认 4 线程，单线程为默认行为）
    speedtest -T 8        # 指定并发线程数
    speedtest -L           # 列出最近的服务器
    speedtest -h           # 查看帮助

说明：
    仅依赖 Python 标准库。
    - 服务器目录与元信息来自 https://cli.speedtest.net/api/cli/config
      （带 ?serverid=<id> 时返回该服务器的信息）。
    - 最近服务器列表与当前公网 IP 相关，每次运行都会重新拉取，
      仅当请求失败（429/离线）时才回退到本地缓存。
    - 测速复用 speedtest.net 服务器公开的 legacy 接口：
      /speedtest/latency.txt、/speedtest/random4000x4000.jpg、/speedtest/upload.php。
    - 输出格式对齐官方 CLI 的 human-readable 结果。

环境变量：
    SPEEDTEST_DURATION   覆盖每个阶段时长（秒，默认取服务端下发值，通常 15）
    SPEEDTEST_THREADS    并发线程数（不指定 -T 时的默认值，默认单线程）
    SPEEDTEST_NO_CACHE=1  不读写 ~/.cache/speedtest 下的配置缓存
    SPEEDTEST_NO_PROGRESS=1   即使终端支持也不显示进度条
    SPEEDTEST_SAVE=1     尝试把结果保存到 speedtest.net（默认关闭，因为该接口未公开）

已知差异：
    - 默认不生成 Result URL（官方通过未公开的 results.speedtest.net 接口保存）。
      设置 SPEEDTEST_SAVE=1 时会尽力尝试，失败则静默跳过。
"""

from __future__ import annotations

import argparse
import http.client
import json
import os
import random
import ssl
import sys
import threading
import time
import urllib.parse
import urllib.request

CONFIG_URL = "https://cli.speedtest.net/api/cli/config"
REPORT_URL = "https://results.speedtest.net/reports"
CONFIG_CACHE_TTL = 12 * 3600  # 官方会给 config 下发过期时间，这里本地缓存 12 小时，避免频繁请求被 429
USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"
)
SSL_CTX = ssl.create_default_context()

PROBE_PATH = "/speedtest/latency.txt"
UPLOAD_PATH = "/speedtest/upload.php"
DOWNLOAD_SIZE = 4000
# 上传按已上送字节计数；块小一些，阶段结束时在途数据更少
UPLOAD_CHUNK = 1024 * 1024
SPINNER = "-\\|/"


# --------------------------------------------------------------------------- #
# 小工具
# --------------------------------------------------------------------------- #
def human_bytes(n):
    units = ["B", "kB", "MB", "GB", "TB"]
    value = float(n)
    idx = 0
    while value >= 1000 and idx < len(units) - 1:
        value /= 1000
        idx += 1
    if idx == 0:
        return "%d B" % int(n)
    return "%.1f %s" % (value, units[idx])


def latency_stats(samples):
    """返回 (low, high, mean, jitter)。jitter 取相邻样本差的平均绝对值。"""
    low = min(samples)
    high = max(samples)
    mean = sum(samples) / len(samples)
    if len(samples) > 1:
        jitter = sum(abs(samples[i] - samples[i - 1]) for i in range(1, len(samples))) / (len(samples) - 1)
    else:
        jitter = 0.0
    return low, high, mean, jitter


def _config_cache_path(server_id):
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    name = "config.json" if server_id is None else "server-%s.json" % server_id
    return os.path.join(base, "speedtest", name)


def _read_cache(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return None


def _write_cache(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
        os.replace(tmp, path)
    except Exception:
        pass


def _fetch_config_remote(server_id=None):
    url = CONFIG_URL
    if server_id is not None:
        url += "?serverid=" + urllib.parse.quote(str(server_id))
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.loads(resp.read().decode("utf-8", "replace"))


def fetch_config(server_id=None):
    """拉取配置。

    指定 serverid 的服务器元信息与客户端位置无关，可放心用 TTL 缓存；
    最近服务器列表（server_id=None）依赖当前公网 IP，必须每次拉新，
    本地缓存只在请求失败时作为兜底。
    """
    no_cache = bool(os.environ.get("SPEEDTEST_NO_CACHE"))
    path = _config_cache_path(server_id)

    # 只有指定 serverid 的元信息可以长期缓存
    if not no_cache and server_id is not None:
        try:
            if time.time() - os.path.getmtime(path) < CONFIG_CACHE_TTL:
                cached = _read_cache(path)
                if cached:
                    return cached
        except OSError:
            pass

    try:
        data = _fetch_config_remote(server_id)
    except Exception:
        cached = _read_cache(path) if not no_cache else None
        if cached:
            if server_id is None:
                print("speedtest: 获取最新服务器列表失败，回退到缓存（可能不是当前 IP 对应的节点）",
                      file=sys.stderr)
            return cached
        raise
    if not no_cache:
        _write_cache(path, data)
    return data


def make_conn(base):
    parts = urllib.parse.urlsplit(base)
    port = parts.port or (443 if parts.scheme == "https" else 80)
    if parts.scheme == "https":
        return http.client.HTTPSConnection(parts.hostname, port, timeout=20, context=SSL_CTX)
    return http.client.HTTPConnection(parts.hostname, port, timeout=20)


def _probe_url(host):
    netloc = host if ":" in host else host + ":80"
    return "http://%s/speedtest/latency.txt?x=%d" % (netloc, random.getrandbits(30))


def _base_from_final(url):
    parts = urllib.parse.urlsplit(url)
    return "%s://%s/speedtest/" % (parts.scheme, parts.netloc)


def _fetch_final(url, timeout):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=timeout, context=SSL_CTX) as resp:
        resp.read()
        return resp.url


def _probe(host, timeout=4):
    """探测服务器，返回 (毫秒, 跳转后的 base)。"""
    start = time.monotonic()
    final = _fetch_final(_probe_url(host), timeout)
    return (time.monotonic() - start) * 1000.0, _base_from_final(final)


def _race(targets, worker, hard_timeout, grace):
    """并发跑 worker(target)，收集成功结果。

    避免被慢/死服务器拖住：拿到第一个成功结果后只再等 grace 秒，
    hard_timeout 是从开始算的总上限。返回成功结果列表（可能为空）。
    """
    hits = []
    lock = threading.Lock()

    def runner(target):
        try:
            value = worker(target)
        except Exception:
            return
        with lock:
            hits.append(value)

    threads = [threading.Thread(target=runner, args=(t,), daemon=True) for t in targets]
    for thread in threads:
        thread.start()
    deadline = time.monotonic() + hard_timeout
    while time.monotonic() < deadline:
        with lock:
            if hits:
                break
        if not any(t.is_alive() for t in threads):
            break  # 全部候选都快失败，不必等满 hard_timeout
        time.sleep(0.05)
    grace_end = time.monotonic() + grace
    while time.monotonic() < grace_end and any(t.is_alive() for t in threads):
        time.sleep(0.02)
    with lock:
        return list(hits)


def resolve_base(server, timeout=6):
    """解析服务器的规范 base。

    并行尝试 server-<id>.prod.hosts.ooklaserver.net、原始 host 的 http/https，
    取第一个成功的跳转地址。全部失败则抛 RuntimeError（不抛超时原始异常）。
    """
    host = server["host"]
    port = host.rsplit(":", 1)[1] if ":" in host else "80"
    candidates = []
    if server.get("id"):
        candidates.append("https://server-%s.prod.hosts.ooklaserver.net:%s" % (server["id"], port))
    candidates.append("http://%s" % host)
    candidates.append("https://%s" % host)

    def worker(netloc):
        url = "%s/speedtest/latency.txt?x=%d" % (netloc, random.getrandbits(30))
        return _base_from_final(_fetch_final(url, timeout))

    hits = _race(candidates, worker, hard_timeout=timeout + 1, grace=0.0)
    if hits:
        return hits[0]
    raise RuntimeError("无法连接服务器 %s" % host)


def select_server(cfg):
    """并发探测最近的几台服务器，返回 (延迟最低的 server, 它的 base)。"""
    servers = [s for s in cfg.get("servers", []) if s.get("host")]
    if not servers:
        raise RuntimeError("配置里没有可用服务器")

    def worker(server):
        ms, base = _probe(server["host"])
        return (ms, server, base)

    hits = _race(servers[:5], worker, hard_timeout=6, grace=0.5)
    if not hits:
        return servers[0], None
    hits.sort(key=lambda item: item[0])
    _, server, base = hits[0]
    return server, base


# --------------------------------------------------------------------------- #
# 测速
# --------------------------------------------------------------------------- #
class _CountingBody:
    """文件式请求体，在 http.client 按块取出时统计已上送字节。

    比“等服务端确认后再计数”更健壮：慢速服务器上，请求在阶段结束时可能仍未返回，
    按已上送字节计数不会得到 0。stop 置位后立即截断，避免结束后还长时间发送。
    """

    def __init__(self, data, add, stop):
        self._data = data
        self._add = add
        self._stop = stop

    def read(self, size=-1):
        if self._stop.is_set() or not self._data:
            return b""
        if size is None or size < 0:
            size = len(self._data)
        chunk = self._data[:size]
        self._data = self._data[size:]
        self._add(len(chunk))
        return chunk


def conn_latency(conn):
    start = time.monotonic()
    conn.request("GET", PROBE_PATH + "?x=%d" % random.getrandbits(30), headers={"User-Agent": USER_AGENT})
    resp = conn.getresponse()
    resp.read()
    return (time.monotonic() - start) * 1000.0


def measure_idle_latency(base, count):
    """测量空闲延迟，返回 (样本列表, 失败数, 总探测数)。"""
    conn = make_conn(base)
    samples = []
    failures = 0
    total = count + 1  # 第一个样本作为预热丢弃
    for index in range(total):
        try:
            ms = conn_latency(conn)
        except Exception:
            failures += 1
            try:
                conn.close()
            except Exception:
                pass
            conn = make_conn(base)
            continue
        if index > 0:
            samples.append(ms)
    try:
        conn.close()
    except Exception:
        pass
    return samples, failures, total


def _render_progress(label, rate_bps, percent, spin):
    filled = percent * 20 // 100
    body = "=" * filled
    if filled < 20:
        body += SPINNER[spin % 4] + " " * (19 - filled)
    line = "\r%12s: %9.2f Mbps [%s] %3d%%" % (label, rate_bps * 8 / 1e6, body[:20], percent)
    sys.stdout.write(line)
    sys.stdout.flush()


def _clear_progress():
    sys.stdout.write("\r" + " " * 78 + "\r")
    sys.stdout.flush()


def run_transfer(label, base, duration, thread_count, upload, progress):
    """并发跑一个阶段的下载或上传，返回统计结果。"""
    lock = threading.Lock()
    counter = {"bytes": 0}
    samples = []
    latencies = []
    stop = threading.Event()
    start = time.monotonic()
    buf = os.urandom(UPLOAD_CHUNK) if upload else None

    def add(n):
        with lock:
            counter["bytes"] += n

    def total():
        with lock:
            return counter["bytes"]

    def worker():
        conn = None
        while not stop.is_set():
            try:
                if conn is None:
                    conn = make_conn(base)
                if upload:
                    conn.request(
                        "POST",
                        UPLOAD_PATH,
                        body=_CountingBody(buf, add, stop),
                        headers={
                            "User-Agent": USER_AGENT,
                            "Content-Type": "application/x-www-form-urlencoded",
                            "Content-Length": str(len(buf)),
                        },
                    )
                    if stop.is_set():
                        # body 被截断，请求不完整，直接关连接
                        try:
                            conn.close()
                        except Exception:
                            pass
                        conn = None
                        break
                    conn.getresponse().read()
                else:
                    conn.request(
                        "GET",
                        "/speedtest/random%dx%d.jpg" % (DOWNLOAD_SIZE, DOWNLOAD_SIZE),
                        headers={"User-Agent": USER_AGENT},
                    )
                    resp = conn.getresponse()
                    while not stop.is_set():
                        chunk = resp.read(1 << 18)
                        if not chunk:
                            break
                        add(len(chunk))
            except Exception:
                try:
                    if conn is not None:
                        conn.close()
                except Exception:
                    pass
                conn = None
                if stop.is_set():
                    break
                time.sleep(0.2)

    def sampler():
        spin = 0
        while not stop.is_set():
            stop.wait(0.1)
            now = time.monotonic()
            current = total()
            samples.append((now, current))
            if progress:
                if current > 0:
                    rate = current / max(now - start, 1e-6)
                    percent = min(99, int((now - start) / duration * 100)) if duration else 0
                else:
                    # 还没有实际流量时冻结进度条（只转 spinner），和官方一致
                    rate = 0.0
                    percent = 0
                _render_progress(label, rate, percent, spin)
                spin += 1

    def prober():
        # 独立的探测线程，避免延迟探测阻塞进度条刷新
        conn = None
        while not stop.is_set():
            try:
                if conn is None:
                    conn = make_conn(base)
                latencies.append(conn_latency(conn))
            except Exception:
                try:
                    if conn is not None:
                        conn.close()
                except Exception:
                    pass
                conn = None
            stop.wait(0.75)
        try:
            if conn is not None:
                conn.close()
        except Exception:
            pass

    workers = [threading.Thread(target=worker, daemon=True) for _ in range(thread_count)]
    mon = threading.Thread(target=sampler, daemon=True)
    probe_thread = threading.Thread(target=prober, daemon=True)
    for thread in workers:
        thread.start()
    mon.start()
    probe_thread.start()

    deadline = start + duration
    while time.monotonic() < deadline and not stop.is_set():
        time.sleep(0.1)
    stop.set()
    mon.join(timeout=3)
    probe_thread.join(timeout=3)
    join_deadline = time.monotonic() + 3
    for thread in workers:
        thread.join(timeout=max(0.0, join_deadline - time.monotonic()))

    elapsed = time.monotonic() - start
    total_bytes = total()
    final_t = time.monotonic()
    samples.append((final_t, total_bytes))

    # 速度取中间稳定窗口（跳过起步爬坡），不把收尾阶段 join 等待也算进去
    def bytes_at(moment):
        value = 0
        for stamp, count in samples:
            if stamp <= moment:
                value = count
            else:
                break
        return value

    t_begin = start + duration * 0.15
    t_end = start + duration * 0.9
    speed = max(bytes_at(t_end) - bytes_at(t_begin), 0) / max(t_end - t_begin, 1e-6)

    if progress:
        _clear_progress()
    return {"bytes": total_bytes, "speed": speed, "latency": latencies, "elapsed": elapsed}


def print_speed_line(label, speed_bps, data_bytes):
    print("%12s: %8.2f Mbps (data used: %s)" % (label, speed_bps * 8 / 1e6, human_bytes(data_bytes)))


def print_loaded_latency(samples):
    if not samples:
        return
    low, high, mean, jitter = latency_stats(samples)
    print("%12s  %8.2f ms   (jitter: %.2fms, low: %.2fms, high: %.2fms)"
          % ("", mean, jitter, low, high))


def try_save_result(cfg, payload):
    """尽力把结果保存到 speedtest.net，失败返回 None。"""
    app = cfg.get("app", {})
    url = app.get("saveTestResultUrl") or REPORT_URL
    key = app.get("licenseKey")
    try:
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "User-Agent": USER_AGENT,
                "Content-Type": "application/json",
                "Accept": "application/json",
                "X-License-Key": key or "",
            },
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8", "replace"))
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    inner = data.get("result") if isinstance(data.get("result"), dict) else {}
    if inner.get("url"):
        return inner["url"]
    rid = data.get("resultid") or data.get("resultId") or data.get("id") or inner.get("id")
    return "https://www.speedtest.net/result/c/%s" % rid if rid else None


# --------------------------------------------------------------------------- #
# 主流程
# --------------------------------------------------------------------------- #
def main(argv):
    parser = argparse.ArgumentParser(
        prog="speedtest",
        description="Speedtest by Ookla 的 Python 复刻",
        add_help=True,
    )
    parser.add_argument("-s", "--server-id", metavar="ID", help="指定服务器 id")
    parser.add_argument("-L", "--servers", action="store_true", help="列出最近的服务器")
    parser.add_argument("-T", "--threads", nargs="?", type=int, const=4, metavar="N",
                        help="多线程测速，线程数默认 4；不指定则单线程")
    parser.add_argument("-V", "--version", action="version", version="speedtest(py) 1.0")
    args = parser.parse_args(argv)

    try:
        cfg = fetch_config(None if args.servers else args.server_id)
    except Exception as exc:
        print("speedtest: 获取配置失败: %s" % exc, file=sys.stderr)
        return 1

    servers = [s for s in cfg.get("servers", []) if s.get("host")]
    if not servers:
        print("speedtest: 未找到服务器 (id=%s)" % args.server_id, file=sys.stderr)
        return 1

    if args.servers:
        print("Closest servers:")
        print()
        print("%6s  %-31s%-21s%s" % ("ID", "Name", "Location", "Country"))
        print("=" * 78)
        for item in servers:
            print("%6s  %-31s%-21s%s"
                  % (item.get("id", ""), item.get("sponsor", ""),
                     item.get("name", ""), item.get("country", "")))
        return 0

    engine = cfg.get("suite", {}).get("global", {}).get("engine", {})
    stage = cfg.get("suite", {}).get("testStage", {})
    duration = int(os.environ.get("SPEEDTEST_DURATION") or engine.get("testDurationSeconds") or 15)
    if args.threads is not None:
        thread_count = args.threads
    else:
        # 不加 -T 时默认单线程
        thread_count = int(os.environ.get("SPEEDTEST_THREADS") or 1)
    if thread_count < 1:
        print("speedtest: 线程数必须 >= 1", file=sys.stderr)
        return 1
    ping_count = int(stage.get("latency", {}).get("pingCount") or 5)
    isp = cfg.get("app", {}).get("ispName") or "Unknown"

    if args.server_id is not None:
        server, base = servers[0], None
    else:
        try:
            server, base = select_server(cfg)
        except Exception as exc:
            print("Error: %s" % exc, file=sys.stderr)
            return 2
    if base is None:
        try:
            base = resolve_base(server)
        except Exception as exc:
            print("Error: %s" % exc, file=sys.stderr)
            return 2
    progress = sys.stdout.isatty() and not os.environ.get("SPEEDTEST_NO_PROGRESS")

    print()
    print("   Speedtest by Ookla")
    print()
    print("      Server: %s - %s (id: %s)"
          % (server.get("sponsor", ""), server.get("name", ""), server.get("id", "")))
    print("         ISP: %s" % isp)

    try:
        idle, failures, probes = measure_idle_latency(base, ping_count)
    except Exception as exc:
        print("Error: Latency test failed: %s" % exc, file=sys.stderr)
        return 2
    if not idle:
        # 和官方一致：连延迟测试都做不了就直接失败退出
        print("Error: Latency test failed", file=sys.stderr)
        return 2
    low, high, mean, jitter = latency_stats(idle)
    print("%12s: %8.2f ms   (jitter: %.2fms, low: %.2fms, high: %.2fms)"
          % ("Idle Latency", mean, jitter, low, high))

    upload_enabled = stage.get("upload", {}).get("isServerUploadEnabled", True)

    try:
        download = run_transfer("Download", base, duration, thread_count, False, progress)
        print_speed_line("Download", download["speed"], download["bytes"])
        print_loaded_latency(download["latency"])

        if upload_enabled:
            upload = run_transfer("Upload", base, duration, thread_count, True, progress)
            print_speed_line("Upload", upload["speed"], upload["bytes"])
            print_loaded_latency(upload["latency"])
        else:
            # 服务端 config 明确禁用上传时不要跑上传阶段
            print("%12s: 已跳过（服务器未开启上传测试）" % "Upload")
    except Exception as exc:
        print("Error: %s" % exc, file=sys.stderr)
        return 2

    loss = (failures / probes * 100.0) if probes else 0.0
    print("%12s: %7.1f%%" % ("Packet Loss", loss))

    if os.environ.get("SPEEDTEST_SAVE"):
        payload = {
            "isp": isp,
            "server": {
                "id": server.get("id"),
                "host": server.get("host", "").split(":")[0],
                "name": server.get("name"),
                "country": server.get("country"),
            },
            "ping": ({"latency": idle[0]} if idle else {}),
            "download": {"bandwidth": int(download["speed"]), "bytes": download["bytes"]},
            "upload": ({"bandwidth": int(upload["speed"]), "bytes": upload["bytes"]}
                       if upload_enabled else {}),
        }
        url = try_save_result(cfg, payload)
        if url:
            print("%12s: %s" % ("Result URL", url))

    return 0


