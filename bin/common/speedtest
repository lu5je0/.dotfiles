#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""speedtest —— Ookla / LibreSpeed 纯 Python 命令行测速。

用法：
    speedtest              # 自动选择延迟最低的最近服务器并测速（默认单线程）
    speedtest -s 12191     # 使用指定 id 的服务器
    speedtest --librespeed  # 自建节点，默认 http://192.168.1.10:3000
    speedtest --librespeed=http://host:3000  # 指定其他 speedtest-x / LibreSpeed 节点
    speedtest -T           # 多线程测速（默认 4 线程，单线程为默认行为）
    speedtest -T 8        # 指定并发线程数
    speedtest -L           # 列出最近的服务器
    speedtest -h           # 查看帮助

说明：
    仅依赖 Python 标准库。
    - 服务器目录与元信息来自 https://cli.speedtest.net/api/cli/config
      （带 ?serverid=<id> 时返回该服务器的信息）。
    - 最近服务器列表与当前公网 IP 相关，每次运行都会重新拉取，
      仅当请求失败（429/离线）时才回退到本地缓存。
    - 测速复用 speedtest.net 服务器公开的 legacy 接口：
      /speedtest/latency.txt、/speedtest/random4000x4000.jpg、/speedtest/upload.php。
    - --librespeed 使用节点 URL 下的 backend/empty.php、backend/garbage.php，
      支持子路径部署，不请求 Ookla 配置，也不保存测速结果。
      上传使用 16 MiB 二进制请求，避免 PHP 表单解析与频繁请求的开销。
    - 输出格式对齐官方 CLI 的 human-readable 结果。
    - 进度条显示最近 2 秒的速度；最终速度统计预热 2 秒后的全部传输时间，
      不含线程退出等待。阶段时长不超过 2 秒时跳过预热。

环境变量：
    SPEEDTEST_DURATION   覆盖每个阶段时长（秒，默认 10）
    SPEEDTEST_THREADS    并发线程数（不指定 -T 时的默认值，默认单线程）
    SPEEDTEST_NO_CACHE=1  不读写 ~/.cache/speedtest 下的配置缓存
    SPEEDTEST_NO_PROGRESS=1   即使终端支持也不显示进度条
    SPEEDTEST_SAVE=1     尝试把结果保存到 speedtest.net（默认关闭，因为该接口未公开）

已知差异：
    - 默认不生成 Result URL（官方通过未公开的 results.speedtest.net 接口保存）。
      设置 SPEEDTEST_SAVE=1 时会尽力尝试，失败则静默跳过。
"""

from __future__ import annotations

import argparse
import http.client
import json
import os
import random
import ssl
import sys
import threading
import time
import urllib.parse
import urllib.request

CONFIG_URL = "https://cli.speedtest.net/api/cli/config"
DEFAULT_LIBRESPEED_URL = "http://192.168.1.10:3000"
REPORT_URL = "https://results.speedtest.net/reports"
CONFIG_CACHE_TTL = 12 * 3600  # 官方会给 config 下发过期时间，这里本地缓存 12 小时，避免频繁请求被 429
USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"
)
SSL_CTX = ssl.create_default_context()

PROBE_PATH = "/speedtest/latency.txt"
UPLOAD_PATH = "/speedtest/upload.php"
DOWNLOAD_SIZE = 4000
# 请求体复用随机数据；每次 socket 发送限制在 IO_CHUNK，以便及时停止。
UPLOAD_CHUNK = 1024 * 1024
LIBRESPEED_UPLOAD_CHUNK = 16 * 1024 * 1024
IO_CHUNK = 256 * 1024
RATE_WINDOW = 2.0
WARMUP_SECONDS = 2.0
SPINNER = "-\\|/"
OOKLA_PATHS = {
    "latency": PROBE_PATH,
    "download": "/speedtest/random%dx%d.jpg" % (DOWNLOAD_SIZE, DOWNLOAD_SIZE),
    "upload": UPLOAD_PATH,
}


