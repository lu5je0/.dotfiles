def human_bytes(n):
    units = ["B", "kB", "MB", "GB", "TB"]
    value = float(n)
    idx = 0
    while value >= 1000 and idx < len(units) - 1:
        value /= 1000
        idx += 1
    if idx == 0:
        return "%d B" % int(n)
    return "%.1f %s" % (value, units[idx])


def latency_stats(samples):
    """返回 (low, high, mean, jitter)。jitter 取相邻样本差的平均绝对值。"""
    low = min(samples)
    high = max(samples)
    mean = sum(samples) / len(samples)
    if len(samples) > 1:
        jitter = sum(abs(samples[i] - samples[i - 1]) for i in range(1, len(samples))) / (len(samples) - 1)
    else:
        jitter = 0.0
    return low, high, mean, jitter


def _config_cache_path(server_id):
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    name = "config.json" if server_id is None else "server-%s.json" % server_id
    return os.path.join(base, "speedtest", name)


def _read_cache(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return None


def _write_cache(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
        os.replace(tmp, path)
    except Exception:
        pass


def _fetch_config_remote(server_id=None):
    url = CONFIG_URL
    if server_id is not None:
        url += "?serverid=" + urllib.parse.quote(str(server_id))
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.loads(resp.read().decode("utf-8", "replace"))


def fetch_config(server_id=None):
    """拉取配置。

    指定 serverid 的服务器元信息与客户端位置无关，可放心用 TTL 缓存；
    最近服务器列表（server_id=None）依赖当前公网 IP，必须每次拉新，
    本地缓存只在请求失败时作为兜底。
    """
    no_cache = bool(os.environ.get("SPEEDTEST_NO_CACHE"))
    path = _config_cache_path(server_id)

    # 只有指定 serverid 的元信息可以长期缓存
    if not no_cache and server_id is not None:
        try:
            if time.time() - os.path.getmtime(path) < CONFIG_CACHE_TTL:
                cached = _read_cache(path)
                if cached:
                    return cached
        except OSError:
            pass

    try:
        data = _fetch_config_remote(server_id)
    except Exception:
        cached = _read_cache(path) if not no_cache else None
        if cached:
            if server_id is None:
                print("speedtest: 获取最新服务器列表失败，回退到缓存（可能不是当前 IP 对应的节点）",
                      file=sys.stderr)
            return cached
        raise
    if not no_cache:
        _write_cache(path, data)
    return data


def make_conn(base):
    parts = urllib.parse.urlsplit(base)
    port = parts.port or (443 if parts.scheme == "https" else 80)
    if parts.scheme == "https":
        return http.client.HTTPSConnection(parts.hostname, port, timeout=20, context=SSL_CTX)
    return http.client.HTTPConnection(parts.hostname, port, timeout=20)


def librespeed_target(url):
    if "://" not in url:
        url = "http://" + url
    parts = urllib.parse.urlsplit(url)
    if (parts.scheme not in ("http", "https") or not parts.hostname
            or parts.username is not None or parts.password is not None
            or parts.query or parts.fragment):
        raise ValueError("请指定 http(s) 节点 URL，不带认证信息、查询参数或片段")
    # 访问 port 属性以校验端口格式与范围。
    parts.port
    base = urllib.parse.urlunsplit((parts.scheme, parts.netloc, parts.path.rstrip("/") + "/", "", ""))
    backend = urllib.parse.urlsplit(urllib.parse.urljoin(base, "backend/")).path
    return base, {
        "latency": backend + "empty.php",
        "download": backend + "garbage.php?ckSize=50",
        "upload": backend + "empty.php",
    }


def check_response(resp):
    if not 200 <= resp.status < 300:
        raise RuntimeError("HTTP %s %s" % (resp.status, resp.reason))


def _probe_url(host):
    netloc = host if ":" in host else host + ":80"
    return "http://%s/speedtest/latency.txt?x=%d" % (netloc, random.getrandbits(30))


def _base_from_final(url):
    parts = urllib.parse.urlsplit(url)
    return "%s://%s/speedtest/" % (parts.scheme, parts.netloc)


def _fetch_final(url, timeout):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=timeout, context=SSL_CTX) as resp:
        resp.read()
        return resp.url


def _probe(host, timeout=4):
    """探测服务器，返回 (毫秒, 跳转后的 base)。"""
    start = time.monotonic()
    final = _fetch_final(_probe_url(host), timeout)
    return (time.monotonic() - start) * 1000.0, _base_from_final(final)


def _race(targets, worker, hard_timeout, grace):
    """并发跑 worker(target)，收集成功结果。

    避免被慢/死服务器拖住：拿到第一个成功结果后只再等 grace 秒，
    hard_timeout 是从开始算的总上限。返回成功结果列表（可能为空）。
    """
    hits = []
    lock = threading.Lock()

    def runner(target):
        try:
            value = worker(target)
        except Exception:
            return
        with lock:
            hits.append(value)

    threads = [threading.Thread(target=runner, args=(t,), daemon=True) for t in targets]
    for thread in threads:
        thread.start()
    deadline = time.monotonic() + hard_timeout
    while time.monotonic() < deadline:
        with lock:
            if hits:
                break
        if not any(t.is_alive() for t in threads):
            break  # 全部候选都快失败，不必等满 hard_timeout
        time.sleep(0.05)
    grace_end = time.monotonic() + grace
    while time.monotonic() < grace_end and any(t.is_alive() for t in threads):
        time.sleep(0.02)
    with lock:
        return list(hits)


def resolve_base(server, timeout=6):
    """解析服务器的规范 base。

    并行尝试 server-<id>.prod.hosts.ooklaserver.net、原始 host 的 http/https，
    取第一个成功的跳转地址。全部失败则抛 RuntimeError（不抛超时原始异常）。
    """
    host = server["host"]
    port = host.rsplit(":", 1)[1] if ":" in host else "80"
    candidates = []
    if server.get("id"):
        candidates.append("https://server-%s.prod.hosts.ooklaserver.net:%s" % (server["id"], port))
    candidates.append("http://%s" % host)
    candidates.append("https://%s" % host)

    def worker(netloc):
        url = "%s/speedtest/latency.txt?x=%d" % (netloc, random.getrandbits(30))
        return _base_from_final(_fetch_final(url, timeout))

    hits = _race(candidates, worker, hard_timeout=timeout + 1, grace=0.0)
    if hits:
        return hits[0]
    raise RuntimeError("无法连接服务器 %s" % host)


def select_server(cfg):
    """并发探测最近的几台服务器，返回 (延迟最低的 server, 它的 base)。"""
    servers = [s for s in cfg.get("servers", []) if s.get("host")]
    if not servers:
        raise RuntimeError("配置里没有可用服务器")

    def worker(server):
        ms, base = _probe(server["host"])
        return (ms, server, base)

    hits = _race(servers[:5], worker, hard_timeout=6, grace=0.5)
    if not hits:
        return servers[0], None
    hits.sort(key=lambda item: item[0])
    _, server, base = hits[0]
    return server, base


