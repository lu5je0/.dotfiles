#!/usr/bin/env python3
"""q-cpuz-benchmark —— 运行 CPU-Z 复刻跑分（自动下载对应平台的预编译二进制）

用法：
    q-cpuz-benchmark                     # 单线程 + 多线程各 10 秒，带实时分数面板
    q-cpuz-benchmark --duration 5000     # 每个 pass 5 秒
    q-cpuz-benchmark -q                  # 只输出两行分数
    q-cpuz-benchmark --json              # 机器可读输出
    q-cpuz-benchmark --help              # 全部参数（透传给 cpuz-bench）

二进制缓存在 ${XDG_CACHE_HOME:-~/.cache}/cpuz-benchmark/cpuz-bench-<os>-<arch>，
默认每次运行静默查一次最新 release（一个 HEAD 请求，不占 API 配额），版本变了就自动重下；
查询失败（离线等）时继续用缓存。

环境变量：
    CPUZ_BENCH_BIN              直接指定已有的二进制，跳过下载
    CPUZ_BENCH_TAG              指定 release 版本（默认 latest，例如 v0.2.4）
    CPUZ_BENCH_URL_PREFIX       自定义下载前缀（默认 GitHub Releases）
    CPUZ_BENCH_FORCE=1          强制重新下载
    CPUZ_BENCH_CACHE_DIR        指定缓存目录
    CPUZ_BENCH_NO_UPDATE_CHECK=1  跳过最新版本检查（离线/想省一次请求时用）

macOS/arm64 额外行为：会自动把 CPU-Z 官方的 cpuz_arm64.exe 放到缓存目录，
因为 aarch64 上只有跑官方内核才是 CPU-Z 会显示的分（我们的构建更快）。
x86_64 上同样会准备官方的 cpuz_x64.exe：那边的内置引擎本来就与官方发布分一致，
但 CPUID 自己的内核才是真值来源。想只用内置引擎就传 --no-official（会透传给 cpuz-bench）。
    CPUZ_ARM64_VERSION          指定官方 ARM64 版本（默认 1.06）
    CPUZ_X64_VERSION            指定官方 x64 版本（默认 3.01）
"""

from __future__ import annotations

import io
import os
import platform
import sys
import zipfile
from pathlib import Path
from urllib import error, request

REPO = "lu5je0/CPU-Z-Benchmark"
RELEASE_LATEST_URL = f"https://github.com/{REPO}/releases/latest"
SUPPORTED = ("linux-x86_64", "linux-aarch64", "macos-aarch64")
TIMEOUT = 10  # 秒：查版本 / 下载的超时
CHUNK = 64 * 1024

# CPU-Z 官方 Windows 内核：由 cpuz-bench 直接映射并调用其 benchmark kernel 计分。
OFFICIAL_ARM64_MEMBER = "cpuz_arm64.exe"
OFFICIAL_ARM64_VERSION = os.environ.get("CPUZ_ARM64_VERSION") or "1.06"
OFFICIAL_ARM64_URL = (
    f"https://download.cpuid.com/cpu-z/arm64/cpuz-arm64_{OFFICIAL_ARM64_VERSION}.zip"
)
OFFICIAL_X64_MEMBER = "cpuz_x64.exe"
OFFICIAL_X64_VERSION = os.environ.get("CPUZ_X64_VERSION") or "3.01"
OFFICIAL_X64_URL = f"https://download.cpuid.com/cpu-z/cpu-z_{OFFICIAL_X64_VERSION}-en.zip"

# 平台 -> release 资产名
OS_MAP = {"linux": "linux", "darwin": "macos"}
ARCH_MAP = {"x86_64": "x86_64", "amd64": "x86_64", "aarch64": "aarch64", "arm64": "aarch64"}


def die(message: str) -> None:
    print(f"q-cpuz-benchmark: {message}", file=sys.stderr)
    raise SystemExit(1)


def enabled(name: str) -> bool:
    return os.environ.get(name, "").lower() not in ("", "0", "false", "no")


def asset_name() -> str:
    system = platform.system().lower()
    machine = platform.machine().lower()
    os_part = OS_MAP.get(system)
    if os_part is None:
        die(f"不支持的平台：{platform.system()}（可在 {REPO} 自行 cargo build --release）")
    arch_part = ARCH_MAP.get(machine)
    if arch_part is None:
        die(f"不支持的架构：{platform.machine()}（可在 {REPO} 自行 cargo build --release）")
    key = f"{os_part}-{arch_part}"
    if key not in SUPPORTED:
        die(f"没有 {key} 的预编译产物（支持 {' / '.join(SUPPORTED)}）")
    return f"cpuz-bench-{key}"


def cache_dir() -> Path:
    env = os.environ.get("CPUZ_BENCH_CACHE_DIR")
    if env:
        return Path(env).expanduser()
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(Path.home(), ".cache")
    return Path(base).expanduser() / "cpuz-benchmark"


def url_prefix(tag: str) -> str:
    env = os.environ.get("CPUZ_BENCH_URL_PREFIX")
    if env:
        return env.rstrip("/")
    return f"https://github.com/{REPO}/releases/{tag}/download"


def remote_tag(tag: str) -> str:
    """把 latest 解析成具体 tag（跟随 github.com 的 302，不占 API 配额）。

    任何失败都返回空串：查不通就继续用缓存。
    """
    if tag != "latest":
        return tag
    if enabled("CPUZ_BENCH_NO_UPDATE_CHECK"):
        return ""
    req = request.Request(RELEASE_LATEST_URL, method="HEAD")
    try:
        with request.urlopen(req, timeout=TIMEOUT) as resp:
            final = resp.geturl()
    except (error.URLError, error.HTTPError, OSError):
        return ""
    if "/tag/" not in final:
        return ""
    return final.rsplit("/tag/", 1)[1].strip()


def download(url: str, dest: Path) -> None:
    """流式下载（终端上画进度条），完成后原子替换。"""
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}")
    show = sys.stderr.isatty()
    try:
        with request.urlopen(url, timeout=TIMEOUT) as resp:
            total = int(resp.headers.get("Content-Length") or 0)
            done = 0
            with open(tmp, "wb") as fh:
                while True:
                    chunk = resp.read(CHUNK)
                    if not chunk:
                        break
                    fh.write(chunk)
                    done += len(chunk)
                    if show and total:
                        pct = done * 100 // total
                        bar = "#" * (pct // 4)
                        print(
                            f"\rq-cpuz-benchmark: 下载 [{bar:<25}] {pct:3d}%",
                            end="",
                            file=sys.stderr,
                            flush=True,
                        )
        if show:
            print(file=sys.stderr)
        os.chmod(tmp, 0o755)
        os.replace(tmp, dest)
    except (error.URLError, error.HTTPError, OSError) as exc:
        try:
            tmp.unlink()
        except OSError:
            pass
        raise RuntimeError(str(exc)) from exc


def failure_hint(asset: str, tag: str) -> str:
    return (
        f"下载失败：{url_prefix(tag)}/{asset}\n"
        f"  - 检查网络，或用 CPUZ_BENCH_TAG=<tag> 指定版本\n"
        f"  - 也可以 clone {REPO} 后 cargo build --release，"
        f"再用 CPUZ_BENCH_BIN=./target/release/cpuz-bench 运行"
    )


def resolve_binary(asset: str) -> Path:
    override = os.environ.get("CPUZ_BENCH_BIN")
    if override:
        path = Path(override).expanduser()
        if not os.access(path, os.X_OK):
            die(f"CPUZ_BENCH_BIN 不可执行：{path}")
        return path

    tag = os.environ.get("CPUZ_BENCH_TAG") or "latest"
    directory = cache_dir()
    binary = directory / asset
    tag_file = directory / f"{asset}.tag"
    url = f"{url_prefix(tag)}/{asset}"

    if enabled("CPUZ_BENCH_FORCE"):
        binary.unlink(missing_ok=True)

    if not os.access(binary, os.X_OK):
        try:
            directory.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            die(f"无法创建缓存目录 {directory}: {exc}")
        print(f"q-cpuz-benchmark: 下载 {url}", file=sys.stderr)
        try:
            download(url, binary)
        except RuntimeError as exc:
            die(f"{failure_hint(asset, tag)}\n  ({exc})")
        resolved = remote_tag(tag)
        if resolved:
            tag_file.write_text(resolved + "\n", encoding="utf-8")
        return binary

    # 缓存命中：版本变了就自动更新（离线或查不到时继续用缓存）
    want = remote_tag(tag)
    have = tag_file.read_text(encoding="utf-8").strip() if tag_file.exists() else ""
    if want and want != have:
        print(
            f"q-cpuz-benchmark: 发现新版本 {want}（缓存 {have or '未知'}），更新中",
            file=sys.stderr,
        )
        try:
            download(url, binary)
        except RuntimeError as exc:
            print(f"q-cpuz-benchmark: 更新失败，继续用缓存版本（{exc}）", file=sys.stderr)
        else:
            tag_file.write_text(want + "\n", encoding="utf-8")
    return binary


def fetch_official_payload(url: str, member: str) -> bytes:
    """取官方 exe：我们的 release 直接放 exe，CPUID 原始源是 zip。"""
    with request.urlopen(url, timeout=TIMEOUT) as resp:
        data = resp.read()
    if data[:2] == b"PK":
        with zipfile.ZipFile(io.BytesIO(data)) as zf:
            return zf.read(member)
    return data


def official_spec() -> tuple[str, str, str] | None:
    """当前平台该准备哪个官方内核：(member, version, upstream_url)。"""
    system = platform.system().lower()
    machine = platform.machine().lower()
    if machine in ("aarch64", "arm64") and system in ("linux", "darwin"):
        return (OFFICIAL_ARM64_MEMBER, OFFICIAL_ARM64_VERSION, OFFICIAL_ARM64_URL)
    if machine in ("x86_64", "amd64") and system == "linux":
        return (OFFICIAL_X64_MEMBER, OFFICIAL_X64_VERSION, OFFICIAL_X64_URL)
    return None


def ensure_official_exe(directory: Path, tag: str) -> None:
    """确保缓存里有本平台对应的 CPU-Z 官方内核 exe。

    cpuz-bench 默认用官方内核计分（aarch64 上我们的构建更快，x86_64 上它是真值来源），
    而它只会在缓存目录 / 环境变量里找这个文件，所以这里先把它准备好。
    优先从我们自己的 release 取（已 vendor 一份），CPUID 源作兜底。
    任何失败都不中断主流程：二进制定会回退到内置引擎。
    """
    spec = official_spec()
    if spec is None:
        return
    member, version, upstream = spec

    target = directory / member
    stamp = directory / f"{member}.version"
    if target.is_file() and stamp.is_file():
        if stamp.read_text(encoding="utf-8").strip() == version:
            return

    print(
        f"q-cpuz-benchmark: 获取 CPU-Z 官方 {member} v{version}"
        f"（{platform.machine()} 默认用官方内核计分）",
        file=sys.stderr,
    )
    last_error: object = "no source"
    for url in (f"{url_prefix(tag)}/{member}", upstream):
        try:
            data = fetch_official_payload(url, member)
        except (error.URLError, error.HTTPError, OSError, KeyError, zipfile.BadZipFile) as exc:
            last_error = exc
            continue
        if len(data) < 1_000_000 or data[:2] != b"MZ":
            last_error = f"unexpected payload from {url} ({len(data)} bytes)"
            continue
        target.write_bytes(data)
        os.chmod(target, 0o755)
        stamp.write_text(version + "\n", encoding="utf-8")
        return
    print(
        f"q-cpuz-benchmark: 官方 exe 获取失败，将用内置引擎：{last_error}",
        file=sys.stderr,
    )


def main(argv: list[str]) -> int:
    tag = os.environ.get("CPUZ_BENCH_TAG") or "latest"
    binary = resolve_binary(asset_name())
    directory = cache_dir()
    try:
        directory.mkdir(parents=True, exist_ok=True)
    except OSError:
        pass
    # --no-official 透传给 cpuz-bench：跳过官方 exe 的下载，用内置引擎。
    args = list(argv[1:])
    if "--no-official" not in args:
        ensure_official_exe(directory, tag)
    # exec 替换进程：信号、退出码、终端行为都与直接运行二进制一致。
    # 显式告诉二进制去哪里找缓存目录；官方 exe 就在里面，不需要额外的环境变量。
    env = dict(os.environ)
    env["CPUZ_BENCHMARK_CACHE_DIR"] = str(directory)
    os.execve(str(binary), [str(binary), *args], env)
    return 127  # 不会走到


if __name__ == "__main__":
    sys.exit(main(sys.argv))
