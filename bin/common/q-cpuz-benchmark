#!/bin/sh
# q-cpuz-benchmark - 运行 CPU-Z 复刻跑分（自动下载对应平台预编译二进制）
#
# 用法：
#   q-cpuz-benchmark                      # 单线程 + 多线程各 10 秒，带实时分数面板
#   q-cpuz-benchmark --duration 5000      # 每个 pass 5 秒
#   q-cpuz-benchmark -q                   # 只输出两行分数
#   q-cpuz-benchmark --json               # 机器可读输出
#   q-cpuz-benchmark --help               # 全部参数（透传给 cpuz-bench）
#
# 二进制缓存在：
#   ${XDG_CACHE_HOME:-$HOME/.cache}/cpuz-benchmark/cpuz-bench-<os>-<arch>
# 默认每次运行会静默查一次最新 release（一个 HEAD 请求），版本变了就自动重下。
#
# 环境变量：
#   CPUZ_BENCH_BIN              直接指定已有的二进制，跳过下载
#   CPUZ_BENCH_TAG              指定 release 版本（默认 latest，例如 v0.2.1）
#   CPUZ_BENCH_URL_PREFIX       自定义下载前缀（默认 GitHub Releases）
#   CPUZ_BENCH_FORCE=1          强制重新下载
#   CPUZ_BENCH_CACHE_DIR        指定缓存目录
#   CPUZ_BENCH_NO_UPDATE_CHECK=1  跳过最新版本检查（离线/想省一次请求时用）
set -eu

REPO="lu5je0/CPU-Z-Benchmark"
CACHE_DIR="${CPUZ_BENCH_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/cpuz-benchmark}"
TAG="${CPUZ_BENCH_TAG:-latest}"
URL_PREFIX="${CPUZ_BENCH_URL_PREFIX:-https://github.com/$REPO/releases/$TAG/download}"
RELEASE_LATEST_URL="https://github.com/$REPO/releases/latest"

die() {
    echo "q-cpuz-benchmark: $*" >&2
    exit 1
}

# ---- 平台识别 -------------------------------------------------------------
os=$(uname -s)
arch=$(uname -m)
case "$os" in
    Linux) os_part=linux ;;
    Darwin) os_part=macos ;;
    *) die "不支持的平台：$os（可在 $REPO 自行 cargo build --release）" ;;
esac
case "$arch" in
    x86_64 | amd64) arch_part=x86_64 ;;
    aarch64 | arm64) arch_part=aarch64 ;;
    *) die "不支持的架构：$arch（可在 $REPO 自行 cargo build --release）" ;;
esac

case "$os_part-$arch_part" in
    linux-x86_64 | linux-aarch64 | macos-aarch64) ;;
    *) die "没有 $os_part-$arch_part 的预编译产物（支持 linux-x86_64 / linux-aarch64 / macos-aarch64）" ;;
esac
asset="cpuz-bench-$os_part-$arch_part"

# ---- 下载 -----------------------------------------------------------------
download() {
    url="$URL_PREFIX/$asset"
    tmp="$CACHE_DIR/.$asset.$$"
    echo "q-cpuz-benchmark: 下载 $url" >&2
    if command -v curl >/dev/null 2>&1; then
        curl -fL --progress-bar -o "$tmp" "$url" || { rm -f "$tmp"; return 1; }
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$tmp" "$url" || { rm -f "$tmp"; return 1; }
    else
        die "需要 curl 或 wget 才能下载"
    fi
    chmod +x "$tmp"
    mv "$tmp" "$CACHE_DIR/$asset"
}

# 把 latest 解析成具体 tag（走 github.com 的 302，不占 API 配额）；失败就返回空
remote_tag() {
    [ "$TAG" = "latest" ] || { printf '%s\n' "$TAG"; return 0; }
    [ "${CPUZ_BENCH_NO_UPDATE_CHECK:-0}" = "1" ] && { printf '\n'; return 0; }
    if command -v curl >/dev/null 2>&1; then
        curl -fsIL -o /dev/null -m 5 -w '%{url_effective}' "$RELEASE_LATEST_URL" 2>/dev/null |
            sed 's#.*/tag/##' || printf '\n'
    elif command -v wget >/dev/null 2>&1; then
        wget -q --spider --server-response -T 5 "$RELEASE_LATEST_URL" 2>&1 |
            sed -n 's#.*Location: .*/tag/\(.*\)\r$#\1#p' | tail -1 || printf '\n'
    else
        printf '\n'
    fi
}

resolve_binary() {
    if [ -n "${CPUZ_BENCH_BIN:-}" ]; then
        [ -x "$CPUZ_BENCH_BIN" ] || die "CPUZ_BENCH_BIN 不可执行：$CPUZ_BENCH_BIN"
        printf '%s\n' "$CPUZ_BENCH_BIN"
        return
    fi

    bin="$CACHE_DIR/$asset"
    tag_file="$CACHE_DIR/$asset.tag"
    if [ "${CPUZ_BENCH_FORCE:-0}" = "1" ]; then
        rm -f "$bin"
    fi

    if [ ! -x "$bin" ]; then
        mkdir -p "$CACHE_DIR" || die "无法创建缓存目录 $CACHE_DIR"
        download || die "下载失败：$URL_PREFIX/$asset
  - 检查网络，或用 CPUZ_BENCH_TAG=<tag> 指定版本
  - 也可以 clone $REPO 后 cargo build --release，再用 CPUZ_BENCH_BIN=./target/release/cpuz-bench 运行"
        remote_tag >"$tag_file"
    else
        # 缓存命中：版本变了就自动更新（离线或查不到时继续用缓存）
        want=$(remote_tag)
        have=$(cat "$tag_file" 2>/dev/null || printf '')
        if [ -n "$want" ] && [ "$want" != "$have" ]; then
            echo "q-cpuz-benchmark: 发现新版本 $want（缓存 ${have:-未知}），更新中" >&2
            if download; then
                printf '%s\n' "$want" >"$tag_file"
            else
                echo "q-cpuz-benchmark: 更新失败，继续用缓存版本" >&2
            fi
        fi
    fi
    printf '%s\n' "$bin"
}

binary=$(resolve_binary)
exec "$binary" "$@"
